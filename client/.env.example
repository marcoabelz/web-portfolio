# Google Gemini API key for the portfolio chat widget.
# Get one at https://aistudio.google.com/apikey
# Server-side only — never rename this to NEXT_PUBLIC_GEMINI_API_KEY.
# Without this variable the chat widget does not render.
GEMINI_API_KEY=
NEXT_PUBLIC_SITE_URL=

# Sign-in for the content editor at /admin, and the GitHub token it commits with.
# All five are required together — with any of them missing /admin returns 404.
# Server-side only, and none of them may be renamed to NEXT_PUBLIC_.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Any long random string: openssl rand -base64 32
ADMIN_SESSION_SECRET=
# Fine-grained personal access token, this repository only, Contents: read and write.
GITHUB_TOKEN=
# owner/repo
GITHUB_REPO=
# Branch the editor commits to. Defaults to main.
GITHUB_BRANCH=